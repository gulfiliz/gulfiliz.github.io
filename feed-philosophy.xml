---
permalink: /feed-philosophy.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Fragmenta · Sképsis · Metaxy — Philosophy</title>
    <link>https://gulfiliz.github.io/</link>
    <atom:link href="{{ '/feed-philosophy.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    <description>Philosophy essays — short introductions with links to the full posts.</description>
    <language>tr</language>
    {% for post in site.tags.philosophy %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description><![CDATA[
        {% if post.description %}<p>{{ post.description }}</p>{% else %}<p>{{ post.excerpt | strip_html | truncate: 240 }}</p>{% endif %}
        <p><a href="{{ post.url | absolute_url }}">Yazının tamamı blogda →</a></p>
      ]]></description>
    </item>
    {% endfor %}
  </channel>
</rss>
